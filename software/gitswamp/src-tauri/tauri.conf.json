{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitSwamp",
  "version": "0.4.0",
  "identifier": "com.wortex.gitswamp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitSwamp",
        "width": 800,
        "height": 600,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDMDdDNTQzRDlFMjNDNzgKUldSNFBPTFpROFVITEJqaW5zVmg3cVlTVStvbzFnVWN0VWs1RGp3dy91M0lIRkhZa0RDRFBUK0MK",
      "endpoints": [
        "https://github.com/mgrabovac22/gitswamp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
