{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitSwamp",
  "version": "0.4.0",
  "identifier": "com.wortex.gitswamp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-linux-package.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitSwamp",
        "width": 800,
        "height": 600,
        "maximized": true,
        "decorations": false,
        "visible": true,
        "backgroundColor": "#020617"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Marin Grabovac",
    "homepage": "https://mgrabovac22.github.io/gitswamp/",
    "category": "DeveloperTool",
    "shortDescription": "Visual Git client with conflict resolution and repository analytics",
    "longDescription": "GitSwamp 0.4.0: visual Git history, staging, file editing, conflict resolution, Time Machine and repository analytics.\n\nGitSwamp update with fixes and improvements.\n\nInstall this package over an older GitSwamp installation, then close and reopen GitSwamp. If the same version is already installed, no reinstall is needed. Repositories and user settings are not removed by a normal upgrade.",
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional",
        "changelog": "packaging/changelog",
        "files": {
          "/usr/share/metainfo/com.wortex.gitswamp.metainfo.xml": "packaging/com.wortex.gitswamp.metainfo.xml",
          "/usr/share/doc/git-swamp/RELEASE-NOTES.txt": "packaging/RELEASE-NOTES.txt",
          "/usr/share/doc/git-swamp/USER-GUIDE.md": "../../../documentation/DOCUMENTATION_31_USER_GUIDE.md"
        }
      }
    },
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMDdGNUJGRDFDMzYwRTIKUldUaVlNUFJ2L1VIVEM0Tm1oaTQ2UktPeGc1R2p6MCtqZURvY05GRzRmZkwzOWhPMGc3elFEL2wK",
      "endpoints": [
        "https://github.com/mgrabovac22/gitswamp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
